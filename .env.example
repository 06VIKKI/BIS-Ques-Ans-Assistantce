# Copy to .env to override defaults. Nothing here is required: the app runs without it.
PORT=8000
NODE_ENV=development

# Comma-separated list of allowed browser origins. "*" is fine for local use;
# set your real domain in production.
CORS_ORIGIN=*

# Requests per minute per IP on /api
RATE_LIMIT_PER_MIN=120

# Delay between streamed chunks of an answer (ms). Set 0 to disable the typing effect.
STREAM_DELAY_MS=16
