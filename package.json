{
  "name": "bis-assist",
  "version": "1.0.0",
  "description": "BIS-Assist: Bureau of Indian Standards QA assistant with forensic citations and a compliance audit module",
  "private": true,
  "type": "module",
  "main": "main.js",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --watch main.js",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "node main.js",
    "test": "node --test",
    "postinstall": "npm --prefix frontend install"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
